<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Request Service | MechNearMe</title>
    <link rel="stylesheet" href="/css/vehicle-request.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<%- include('../common/navbar.ejs') %>

<section class="request-wrapper">

    <div class="request-card">

        <h1>Request Service / Repair</h1>
        <p class="subtitle">
            You’re requesting service for:
        </p>

        <!-- VEHICLE INFO -->
        <div class="vehicle-info">
            <h3><%= vehicle.brand %> <%= vehicle.model %></h3>
            <p><%= vehicle.vehicleNumber %> • <%= vehicle.vehicleType %></p>
        </div>

        <form action="/service/request" method="POST">

            <!-- Hidden vehicle ID -->
            <input type="hidden" name="vehicleId" value="<%= vehicle._id %>">

            <!-- REQUEST TYPE -->
            <div class="form-group">
                <label>Request Type</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="requestType" value="repair" required>
                        Repair
                    </label>
                    <label>
                        <input type="radio" name="requestType" value="service" required>
                        Service
                    </label>
                </div>
            </div>

            <!-- ISSUE -->
            <div class="form-group">
                <label>Describe the Issue</label>
                <textarea
                    name="issueDescription"
                    rows="4"
                    placeholder="e.g. Engine won’t start, oil change, brake issue..."
                ></textarea>
            </div>

            <button type="submit" class="btn primary full">
                Send Request
            </button>

        </form>

    </div>

</section>

</body>
</html>
