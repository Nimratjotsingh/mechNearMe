<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Request Service | MechNearMe</title>
    <link rel="stylesheet" href="/css/request.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<!-- NAVBAR -->
<%- include('../common/navbar.ejs') %>

<section class="request-page">

    <div class="request-card">

        <h1>Request Service / Repair</h1>
        <p class="subtitle">
            Tell us what’s wrong and nearby mechanics will help you.
        </p>

        <form action="/service/request" method="POST">

            <!-- VEHICLE -->
            <div class="form-group">
                <label>Select Vehicle</label>
                <select name="vehicleId" required>
                    <option value="">Choose your vehicle</option>
                    <% vehicles.forEach(vehicle => { %>
                        <option value="<%= vehicle._id %>">
                            <%= vehicle.brand %> <%= vehicle.model %> – <%= vehicle.vehicleNumber %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- REQUEST TYPE -->
            <div class="form-group">
                <label>Request Type</label>
                <div class="radio-group">
                    <label>
                        <input type="radio" name="requestType" value="repair" required>
                        Repair
                    </label>
                    <label>
                        <input type="radio" name="requestType" value="service" required>
                        Service
                    </label>
                </div>
            </div>

            <!-- ISSUE -->
            <div class="form-group">
                <label>Describe the Issue</label>
                <textarea
                    name="issueDescription"
                    placeholder="e.g. Car won’t start, strange noise, brake issue..."
                    rows="4"></textarea>
            </div>

            <button type="submit" class="btn primary full">
                Send Request
            </button>

        </form>

    </div>

</section>

</body>
</html>
