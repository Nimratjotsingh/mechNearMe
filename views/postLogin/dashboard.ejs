<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard | MechNearMe</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<!-- NAVBAR -->
<%- include('../common/navbar.ejs') %>

<!-- DASHBOARD CONTAINER -->
<section class="dashboard">

    <h1>Welcome, <%= user.name %> 👋</h1>
    <p class="subtitle">Manage your vehicles and get instant help when needed</p>

    <!-- QUICK ACTIONS -->
    <div class="quick-actions">
        <div class="card">
            <h3>➕ Add Vehicle</h3>
            <p>Save your car or bike for easy service access</p>
            <a href="/add-vehicle"><button>Continue</button></a> 
        </div>

        <div class="card">
            <h3>🔧 Request Repair</h3>
            <p>Breakdown? Get mechanic help instantly</p>
            <button disabled>Coming Soon</button>
        </div>

        <div class="card">
            <h3>🛠️ Schedule Service</h3>
            <p>Plan regular servicing for your vehicle</p>
            <button disabled>Coming Soon</button>
        </div>
    </div>

    <!-- VEHICLE SECTION -->
    <!-- VEHICLE SECTION -->
<div class="vehicles">
    <h2>Your Vehicles</h2>

    <% if (!vehicles || vehicles.length === 0) { %>
        <p class="empty-state">You haven’t added any vehicles yet.</p>
    <% } else { %>

        <div class="vehicle-grid">
            <% vehicles.forEach(vehicle => { 
                const carImages = ['https://png.pngtree.com/png-vector/20231014/ourlarge/pngtree-generic-brandless-sports-car-front-png-image_10239859.png', 'https://t3.ftcdn.net/jpg/00/79/71/36/360_F_79713649_GqVb9ZF7lj2JU2SO7BC2f1aZuvJ2GeiM.jpg'];
                const bikeImages = ['/images/vehicles/bike1.png', '/images/vehicles/bike2.png'];

                const images = vehicle.vehicleType === 'bike' ? bikeImages : carImages;
                const randomImage = images[Math.floor(Math.random() * images.length)];
            %>

                <div class="vehicle-card">
                    <img src="<%= randomImage %>" alt="vehicle">

                    <div class="vehicle-info">
                        <h3><%= vehicle.brand %> <%= vehicle.model %></h3>
                        <p class="number"><%= vehicle.vehicleNumber %></p>

                        <div class="meta">
                            <span><%= vehicle.vehicleType.toUpperCase() %></span>
                            <span><%= vehicle.year %></span>
                        </div>

                        <div class="actions">
                            <button class="repair">Request Repair</button>
                            <button class="service">Schedule Service</button>
                            <button class="delete">Delete Vehicle</button>
                        </div>
                    </div>
                </div>

            <% }) %>
        </div>

    <% } %>
</div>


</section>

</body>
</html>
