<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mechanic Login | MechNearMe</title>
    <link rel="stylesheet" href="/css/login.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="page">

    <!-- NAVBAR -->
    <header class="navbar">
        <h2 class="logo">Mech<span>NearMe</span></h2>
        <a href="/" class="back-link">← Back</a>
    </header>

    <!-- LOGIN CARD -->
    <section class="auth-wrapper">
        <form class="auth-card" action="/login" method="POST">

            <h1>Mechanic Login</h1>
            <p class="subtitle">
                Login to accept service requests and manage your jobs.
            </p>

            <div class="form-group">
                <label>Email</label>
                <input
                    type="email"
                    name="email"
                    placeholder="you@workshop.com"
                    required>
            </div>

            <div class="form-group">
                <label>Password</label>
                <input
                    type="password"
                    name="password"
                    placeholder="••••••••"
                    required>
            </div>

            <button type="submit" class="btn primary full">
                Login
            </button>

            <p class="footer-text">
                Don’t have an account?
                <a href="/register">Register here</a>
            </p>

        </form>
    </section>

</div>

</body>
</html>
