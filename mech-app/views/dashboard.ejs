<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mechanic Dashboard | MechNearMe</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="page">

    <!-- TOP BAR -->
    <header class="topbar">
        <h2 class="logo">Mech<span>NearMe</span></h2>

        <div class="profile">
            <span class="status online"></span>
            <span class="name"><%= mechanic.name %></span>
            <a href="/logout" class="logout">Logout</a>
        </div>
    </header>

    <!-- DASHBOARD CONTENT -->
    <main class="dashboard">

        <!-- STATS -->
        <section class="stats">
            <div class="stat-card">
                <h3>Available Jobs</h3>
                <p>3</p>
            </div>

            <div class="stat-card">
                <h3>Active Jobs</h3>
                <p>1</p>
            </div>

            <div class="stat-card">
                <h3>Completed</h3>
                <p>12</p>
            </div>
        </section>

        <!-- JOB REQUESTS -->
        <section class="jobs">
            <h2>Incoming Service Requests</h2>

            <!-- JOB CARD -->
            <div class="job-card">
                <div class="job-info">
                    <h3>Car Repair</h3>
                    <p><strong>Vehicle:</strong> Hyundai i20</p>
                    <p><strong>Issue:</strong> Engine overheating</p>
                    <p><strong>Location:</strong> <%= mechanic.location %></p>
                </div>

                <div class="job-actions">
                    <button class="accept">Accept</button>
                    <button class="reject">Reject</button>
                </div>
            </div>

            <!-- EMPTY STATE (later dynamic) -->
            <!--
            <p class="empty">No new requests right now</p>
            -->

        </section>

    </main>

</div>

</body>
</html>
