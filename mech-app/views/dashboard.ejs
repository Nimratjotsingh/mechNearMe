<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Mechanic Dashboard | MechNearMe</title>
    <link rel="stylesheet" href="/css/dashboard.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="page">

    <!-- TOP BAR -->
    <header class="topbar">
        <h2 class="logo">Mech<span>NearMe</span></h2>

        <div class="profile">
            <a href="/jobs/history"><button>📜</button></a>
            <span class="status online"></span>
            <span class="name"><%= user.name %></span>
            <a href="/logout" class="logout">Logout</a>
        </div>
    </header>

    <!-- DASHBOARD -->
    <main class="dashboard">

        <h1 class="heading">Available Service Requests</h1>
        <p class="subheading">
            Accept a request to start working
        </p>

        <% if (!jobs || jobs.length === 0) { %>
            <div class="empty">
                No service requests available right now.
            </div>
        <% } else { %>

            <div class="job-list">
                <% jobs.forEach(job => { %>

                    <div class="job-card">

                        <div class="job-info">
                            <h3><%= job.requestType.toUpperCase() %></h3>

                            <p>
                                <strong>Vehicle:</strong>
                                <%= job.vehicle.brand %> <%= job.vehicle.model %>
                            </p>

                            <p class="muted">
                                <%= job.vehicle.vehicleNumber %> • <%= job.vehicle.vehicleType %>
                            </p>

                            <% if (job.issueDescription) { %>
                                <p class="issue">
                                    <strong>Issue:</strong> <%= job.issueDescription %>
                                </p>
                            <% } %>

                            <p class="muted">
                                Requested by <%= job.user.name %>
                            </p>
                        </div>

                        <div class="job-actions">

                            <form action="/jobs/accept/<%= job._id %>" method="POST">
                                <button class="accept">Accept</button>
                            </form>

                            <form action="/jobs/reject/<%= job._id %>" method="POST">
                                <button class="reject">Reject</button>
                            </form>

                            <a href="/jobs/<%= job._id %>" class="view">
                                View Details →
                            </a>

                        </div>

                    </div>

                <% }) %>
            </div>

        <% } %>

    </main>

</div>

</body>
</html>
