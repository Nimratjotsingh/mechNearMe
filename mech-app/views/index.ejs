<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>MechNearMe | Mechanic Portal</title>
    <link rel="stylesheet" href="/css/index.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

<div class="page">

<header class="navbar">
    <h2 class="logo">Mech<span>NearMe</span></h2>

    <div class="nav-actions">
        <a href="/login" class="btn ghost">Login</a>
        <a href="/register" class="btn primary">Register</a>
    </div>
</header>

<section class="hero">
    <div class="hero-content">
        <h1>Mechanic Partner Portal</h1>
        <p>
            Receive nearby repair and service requests,
            manage jobs efficiently, and grow your workshop.
        </p>

        <div class="hero-actions">
            <a href="/register" class="btn primary">Get Started</a>
            <a href="/login" class="btn secondary">I already have an account</a>
        </div>
    </div>

    <div class="hero-card">
        <ul>
            <li>🔧 Real-time service requests</li>
            <li>📍 Nearby customer jobs</li>
            <li>✅ Accept or reject work</li>
            <li>📊 Track job status</li>
        </ul>
    </div>
</section>

<footer class="footer">
    <p>© 2026 MechNearMe • Mechanic Platform</p>
</footer>

</div>

</body>
</html>
